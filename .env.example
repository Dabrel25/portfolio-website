# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

ANTHROPIC_API_KEY=

# The chat API queries this Neo4j instance at request time via a Cypher
# tool. Locally this can point at the docker-compose Neo4j (see
# `npm run neo4j:up` / `npm run neo4j:seed`); in production, point it at a
# Neo4j Aura instance seeded from the same script, using a READ-ONLY
# database user/role — the app should never hold write credentials.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
